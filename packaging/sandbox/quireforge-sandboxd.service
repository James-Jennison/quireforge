[Unit]
Description=QuireForge isolated ELF analysis worker
After=local-fs.target
ConditionPathExists=/dev/kvm

[Service]
Type=simple
ExecStart=/usr/sbin/quireforge-sandboxd
Restart=on-failure
RestartSec=2
User=root
Group=root
RuntimeDirectory=quireforge-sandboxd
RuntimeDirectoryMode=0755
StateDirectory=quireforge-sandboxd
StateDirectoryMode=0700
PrivateTmp=true
PrivateNetwork=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/quireforge-sandboxd /run/quireforge-sandboxd
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=false
Delegate=true
DevicePolicy=closed
DeviceAllow=/dev/kvm rw
DeviceAllow=/dev/null rw
DeviceAllow=/dev/urandom r
RestrictAddressFamilies=AF_UNIX
LockPersonality=true
MemoryDenyWriteExecute=false
NoNewPrivileges=false

[Install]
WantedBy=multi-user.target
