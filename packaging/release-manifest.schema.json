{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quireforge.jamesjennison.net/schemas/release-manifest-v1.json",
  "title": "QuireForge release manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "state",
    "version",
    "source",
    "builder",
    "provenance",
    "abi",
    "artifacts"
  ],
  "properties": {
    "schemaVersion": {
      "const": 2
    },
    "state": {
      "const": "release-candidate"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "commit",
        "treeState"
      ],
      "properties": {
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "treeState": {
          "const": "clean"
        }
      }
    },
    "builder": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "distribution",
        "version",
        "architecture",
        "image"
      ],
      "properties": {
        "distribution": {
          "const": "ubuntu"
        },
        "version": {
          "const": "22.04"
        },
        "architecture": {
          "const": "x86_64"
        },
        "image": {
          "type": "string",
          "pattern": "^ubuntu:22\\.04@sha256:[0-9a-f]{64}$"
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "command",
        "containerImage"
      ],
      "properties": {
        "kind": {
          "const": "pinned-ubuntu-22.04-container"
        },
        "command": {
          "const": "scripts/run_linux_package_container.sh"
        },
        "containerImage": {
          "type": "string",
          "pattern": "^ubuntu:22\\.04@sha256:[0-9a-f]{64}$"
        }
      }
    },
    "abi": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "baseline",
        "highestRequired",
        "binaries"
      ],
      "properties": {
        "baseline": {
          "const": "GLIBC_2.35"
        },
        "highestRequired": {
          "pattern": "^GLIBC_[0-9]+\\.[0-9]+$",
          "type": "string"
        },
        "binaries": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "format",
              "highestRequired"
            ],
            "properties": {
              "format": {
                "enum": [
                  "appimage",
                  "deb"
                ]
              },
              "highestRequired": {
                "type": "string",
                "pattern": "^GLIBC_[0-9]+\\.[0-9]+$"
              }
            }
          }
        }
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "format",
          "filename",
          "architecture",
          "packageVersion",
          "sha256",
          "size"
        ],
        "properties": {
          "format": {
            "enum": [
              "appimage",
              "deb"
            ]
          },
          "filename": {
            "type": "string"
          },
          "architecture": {
            "const": "x86_64"
          },
          "packageVersion": {
            "type": "string"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "size": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    }
  }
}
